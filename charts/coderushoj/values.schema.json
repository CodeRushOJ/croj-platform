{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CodeRushOJ application chart values",
  "type": "object",
  "required": ["deploymentProfile", "applications", "adminBootstrap", "gateway", "secrets", "images", "services", "judgingServer", "sandbox"],
  "properties": {
    "deploymentProfile": {
      "type": "string",
      "enum": ["development", "production"]
    },
    "applications": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "adminBootstrap": {
      "type": "object",
      "required": ["enabled", "secretName", "activeDeadlineSeconds", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "secretName": {"type": "string"},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 30, "maximum": 1800},
        "resources": {
          "type": "object",
          "required": ["requests", "limits"]
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["className", "host", "docsHost", "judgeHost", "tls", "envoyProxy"],
      "properties": {
        "className": {"type": "string", "minLength": 1},
        "host": {"$ref": "#/definitions/hostname"},
        "docsHost": {"$ref": "#/definitions/hostname"},
        "judgeHost": {"$ref": "#/definitions/hostname"},
        "tls": {
          "type": "object",
          "required": ["enabled", "secretName"],
          "properties": {
            "enabled": {"type": "boolean"},
            "secretName": {"type": "string"}
          }
        },
        "envoyProxy": {
          "type": "object",
          "required": ["enabled", "nodePort", "externalTrafficPolicy"],
          "properties": {
            "enabled": {"type": "boolean"},
            "nodePort": {"type": "integer", "minimum": 30000, "maximum": 32767},
            "externalTrafficPolicy": {
              "type": "string",
              "enum": ["Local", "Cluster"]
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1}
      }
    },
    "images": {
      "type": "object",
      "required": ["frontend", "backend", "judgingServer", "sandbox", "docs"],
      "properties": {
        "frontend": {"$ref": "#/definitions/image"},
        "backend": {"$ref": "#/definitions/image"},
        "judgingServer": {"$ref": "#/definitions/image"},
        "sandbox": {"$ref": "#/definitions/image"},
        "docs": {"$ref": "#/definitions/image"}
      }
    },
    "frontend": {"$ref": "#/definitions/workload"},
    "backend": {
      "allOf": [
        {"$ref": "#/definitions/workload"},
        {
          "type": "object",
          "required": ["corsAllowedOrigins", "uploads", "smtp"],
          "properties": {
            "corsAllowedOrigins": {"type": "string", "minLength": 1},
            "uploads": {
              "type": "object",
              "required": ["storage", "storageClassName"],
              "properties": {
                "storage": {"type": "string", "minLength": 1},
                "storageClassName": {"type": "string"}
              }
            },
            "smtp": {
              "type": "object",
              "required": ["host", "port", "username", "auth", "startTLS", "ssl"],
              "properties": {
                "host": {"type": "string"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "username": {"type": "string"},
                "auth": {"type": "boolean"},
                "startTLS": {"type": "boolean"},
                "ssl": {"type": "boolean"}
              }
            }
          }
        }
      ]
    },
    "docs": {"$ref": "#/definitions/workload"},
    "judgingServer": {
      "allOf": [
        {"$ref": "#/definitions/workload"},
        {
          "type": "object",
          "required": ["externalAPI"],
          "properties": {
            "externalAPI": {
              "type": "object",
              "required": ["enabled", "expose", "listenAddress", "workerConcurrency", "tls"],
              "properties": {
                "enabled": {"type": "boolean"},
                "expose": {"type": "boolean"},
                "listenAddress": {"type": "string", "pattern": "^[^:]+:[0-9]{1,5}$"},
                "workerConcurrency": {"type": "integer", "minimum": 1, "maximum": 256},
                "tls": {
                  "type": "object",
                  "required": ["enabled", "secretName"],
                  "properties": {
                    "enabled": {"type": "boolean"},
                    "secretName": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "sandbox": {
      "allOf": [
        {"$ref": "#/definitions/workload"},
        {
          "type": "object",
          "required": ["maxConcurrency", "runtimeClassName", "nodeSelector"],
          "properties": {
            "maxConcurrency": {"type": "integer", "minimum": 1, "maximum": 64},
            "runtimeClassName": {"type": "string"},
            "nodeSelector": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "string"}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adminBootstrap": {
            "properties": {"enabled": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "applications": {
            "properties": {"enabled": {"const": true}}
          },
          "adminBootstrap": {
            "properties": {"secretName": {"minLength": 1}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "judgingServer": {
            "properties": {
              "externalAPI": {
                "properties": {"expose": {"const": true}}
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "judgingServer": {
            "properties": {
              "externalAPI": {
                "properties": {"enabled": {"const": true}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deploymentProfile": {"const": "production"},
          "judgingServer": {
            "properties": {
              "externalAPI": {
                "properties": {"expose": {"const": true}}
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "judgingServer": {
            "properties": {
              "externalAPI": {
                "properties": {
                  "tls": {
                    "properties": {"enabled": {"const": true}}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"deploymentProfile": {"const": "production"}}
      },
      "then": {
        "properties": {
          "backend": {
            "properties": {
              "smtp": {
                "properties": {
                  "host": {"minLength": 1},
                  "username": {"minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"},
        "pullPolicy": {"type": "string", "enum": ["IfNotPresent", "Never"]}
      }
    },
    "workload": {
      "type": "object",
      "required": ["replicas", "resources"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1, "maximum": 100},
        "resources": {
          "type": "object",
          "required": ["requests", "limits"]
        }
      }
    }
  }
}
