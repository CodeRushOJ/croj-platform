{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["backend", "frontend", "judgingServer", "sandbox", "networkPolicy"],
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "requireDigest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$" },
        "requireDigest": { "type": "boolean" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["cpu", "memory"] }
      }
    },
    "securityContext": {
      "type": "object",
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "runAsNonRoot", "runAsUser", "runAsGroup", "capabilities", "seccompProfile"],
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "capabilities": { "type": "object" },
        "seccompProfile": { "type": "object" }
      }
    },
    "pdb": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "topologySpread": {
      "type": "object",
      "required": ["enabled", "maxSkew", "topologyKey", "whenUnsatisfiable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxSkew": { "type": "integer", "minimum": 1 },
        "topologyKey": { "type": "string", "minLength": 1 },
        "whenUnsatisfiable": { "enum": ["DoNotSchedule", "ScheduleAnyway"] }
      }
    },
    "antiAffinity": {
      "type": "object",
      "required": ["enabled", "topologyKey"],
      "properties": {
        "enabled": { "type": "boolean" },
        "topologyKey": { "type": "string", "minLength": 1 }
      }
    },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
    }
  },
  "properties": {
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "gateway", "infra", "dns", "external"],
      "properties": {
        "enabled": { "type": "boolean" },
        "gateway": {
          "type": "object",
          "required": ["namespace"],
          "properties": { "namespace": { "type": "string", "minLength": 1 } }
        },
        "infra": {
          "type": "object",
          "required": ["instance"],
          "properties": { "instance": { "type": "string", "minLength": 1 } }
        },
        "dns": {
          "type": "object",
          "required": ["namespace", "podLabels"],
          "properties": {
            "namespace": { "type": "string", "minLength": 1 },
            "podLabels": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } }
          }
        },
        "external": {
          "type": "object",
          "required": ["smtpCidrs", "kubernetesApiCidrs"],
          "properties": {
            "smtpCidrs": { "type": "array", "items": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/(3[0-2]|[12]?[0-9])$" } },
            "kubernetesApiCidrs": { "type": "array", "items": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/(3[0-2]|[12]?[0-9])$" } }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "required": ["enabled", "replicaCount", "image", "service", "existingSecret", "config", "storage", "probes", "resources", "securityContext", "pdb", "topologySpread", "antiAffinity"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "service": {
          "type": "object",
          "required": ["name", "port", "containerPort"],
          "properties": {
            "name": { "enum": ["croj-backend"] },
            "port": { "const": 7999 },
            "containerPort": { "const": 7999 }
          }
        },
        "existingSecret": {
          "type": "object",
          "required": ["name", "keys"],
          "properties": {
            "name": { "type": "string" },
            "keys": {
              "type": "object",
              "required": ["databaseUsername", "databasePassword", "redisPassword", "rocketmqAccessKey", "rocketmqSecretKey", "jwtSecret", "smtpUsername", "smtpPassword", "judgeResultServiceToken"],
              "additionalProperties": { "type": "string", "minLength": 1 },
              "properties": {
                "databaseUsername": { "type": "string", "minLength": 1 },
                "databasePassword": { "type": "string", "minLength": 1 },
                "redisPassword": { "type": "string", "minLength": 1 },
                "rocketmqAccessKey": { "type": "string", "minLength": 1 },
                "rocketmqSecretKey": { "type": "string", "minLength": 1 },
                "jwtSecret": { "type": "string", "minLength": 1 },
                "smtpUsername": { "type": "string", "minLength": 1 },
                "smtpPassword": { "type": "string", "minLength": 1 },
                "judgeResultServiceToken": { "const": "JUDGE_RESULT_SERVICE_TOKEN" }
              }
            }
          }
        },
        "config": { "type": "object" },
        "storage": {
          "type": "object",
          "required": ["type", "existingClaim", "mountPath"],
          "properties": {
            "type": { "enum": ["emptyDir", "existingClaim"] },
            "existingClaim": { "type": "string" },
            "mountPath": { "const": "/app/uploads" }
          }
        },
        "probes": { "type": "object" },
        "resources": { "$ref": "#/definitions/resources" },
        "securityContext": { "$ref": "#/definitions/securityContext" },
        "pdb": { "$ref": "#/definitions/pdb" },
        "topologySpread": { "$ref": "#/definitions/topologySpread" },
        "antiAffinity": { "$ref": "#/definitions/antiAffinity" }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["enabled", "replicaCount", "image", "service", "probes", "resources", "securityContext", "pdb", "topologySpread", "antiAffinity"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "service": {
          "type": "object",
          "required": ["name", "port", "containerPort"],
          "properties": {
            "name": { "enum": ["croj-frontend"] },
            "port": { "const": 80 },
            "containerPort": { "const": 8080 }
          }
        },
        "probes": { "type": "object" },
        "resources": { "$ref": "#/definitions/resources" },
        "securityContext": { "$ref": "#/definitions/securityContext" },
        "pdb": { "$ref": "#/definitions/pdb" },
        "topologySpread": { "$ref": "#/definitions/topologySpread" },
        "antiAffinity": { "$ref": "#/definitions/antiAffinity" }
      }
    },
    "judgingServer": {
      "type": "object",
      "required": ["enabled", "replicaCount", "image", "existingSecret", "config", "probes", "resources", "securityContext", "pdb", "topologySpread", "antiAffinity", "discoveryRbac"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "existingSecret": {
          "type": "object",
          "required": ["name", "keys"],
          "properties": {
            "name": { "type": "string" },
            "keys": {
              "type": "object",
              "required": ["databaseUsername", "databasePassword", "rocketmqAccessKey", "rocketmqSecretKey", "objectStorageAccessKey", "objectStorageSecretKey", "judgeResultServiceToken"],
              "additionalProperties": { "type": "string", "minLength": 1 },
              "properties": {
                "databaseUsername": { "type": "string", "minLength": 1 },
                "databasePassword": { "type": "string", "minLength": 1 },
                "rocketmqAccessKey": { "type": "string", "minLength": 1 },
                "rocketmqSecretKey": { "type": "string", "minLength": 1 },
                "objectStorageAccessKey": { "type": "string", "minLength": 1 },
                "objectStorageSecretKey": { "type": "string", "minLength": 1 },
                "judgeResultServiceToken": { "const": "JUDGE_RESULT_SERVICE_TOKEN" }
              }
            }
          }
        },
        "config": {
          "type": "object",
          "required": ["backendInternalUrl", "callbackTimeout", "submissionTopic", "consumerGroup", "sandboxNamespace", "sandboxService", "sandboxPortName", "sandboxExecuteTimeout", "bundleCacheDir", "bundleCacheMaxBytes", "bundleCacheTTL", "bundleMaxObjectBytes", "bundleMaxFiles", "bundleMaxManifestBytes", "bundleMaxCaseBytes", "bundleMaxUncompressedBytes", "bundleMaxCompressionRatio", "bundleMaxInfraAttempts", "bundleCacheSizeLimit", "objectStorageEndpoint", "objectStorageBucket", "objectStorageRegion", "objectStorageUseTLS"],
          "properties": {
            "backendInternalUrl": { "const": "http://croj-backend:7999/api" },
            "callbackTimeout": { "$ref": "#/definitions/duration" },
            "submissionTopic": { "type": "string", "pattern": "^.+\\.v[1-9][0-9]*$" },
            "consumerGroup": { "type": "string", "pattern": "^.+-v[1-9][0-9]*$" },
            "sandboxNamespace": { "type": "string", "minLength": 1 },
            "sandboxService": { "const": "croj-sandbox" },
            "sandboxPortName": { "const": "grpc" },
            "sandboxExecuteTimeout": { "$ref": "#/definitions/duration" },
            "bundleCacheDir": { "const": "/tmp/croj-bundles" },
            "bundleCacheMaxBytes": { "type": "integer", "minimum": 1 },
            "bundleCacheTTL": { "$ref": "#/definitions/duration" },
            "bundleMaxObjectBytes": { "type": "integer", "minimum": 1 },
            "bundleMaxFiles": { "type": "integer", "minimum": 1 },
            "bundleMaxManifestBytes": { "type": "integer", "minimum": 1 },
            "bundleMaxCaseBytes": { "type": "integer", "minimum": 1 },
            "bundleMaxUncompressedBytes": { "type": "integer", "minimum": 1 },
            "bundleMaxCompressionRatio": { "type": "integer", "minimum": 1 },
            "bundleMaxInfraAttempts": { "type": "integer", "minimum": 1 },
            "bundleCacheSizeLimit": { "enum": ["512Mi", "1Gi", "2Gi", "4Gi"] },
            "objectStorageEndpoint": { "type": "string", "pattern": "^[A-Za-z0-9.-]+(:[1-9][0-9]{0,4})?$" },
            "objectStorageBucket": { "type": "string", "minLength": 1 },
            "objectStorageRegion": { "type": "string", "minLength": 1 },
            "objectStorageUseTLS": { "enum": ["true", "false"] }
          }
        },
        "probes": { "type": "object", "required": ["enabled"] },
        "resources": { "$ref": "#/definitions/resources" },
        "securityContext": { "$ref": "#/definitions/securityContext" },
        "pdb": { "$ref": "#/definitions/pdb" },
        "topologySpread": { "$ref": "#/definitions/topologySpread" },
        "antiAffinity": { "$ref": "#/definitions/antiAffinity" },
        "discoveryRbac": {
          "type": "object",
          "required": ["enabled", "serviceAccountName"],
          "properties": {
            "enabled": { "type": "boolean" },
            "serviceAccountName": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "required": ["enabled", "replicaCount", "maxConcurrency", "image", "service", "resources", "securityContext", "hostCgroup", "networkPolicy"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "maxConcurrency": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "service": {
          "type": "object",
          "required": ["name", "port"],
          "properties": {
            "name": { "type": "string", "enum": ["croj-sandbox"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "runtimeClassName": { "type": "string" },
        "hostPID": { "type": "boolean" },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resources" },
        "securityContext": {
          "type": "object",
          "required": ["privileged", "allowPrivilegeEscalation", "readOnlyRootFilesystem", "runAsNonRoot"],
          "properties": {
            "privileged": { "type": "boolean" },
            "allowPrivilegeEscalation": { "type": "boolean" },
            "readOnlyRootFilesystem": { "type": "boolean" },
            "runAsNonRoot": { "type": "boolean" }
          }
        },
        "hostCgroup": {
          "type": "object",
          "required": ["enabled", "path", "mountPropagation"],
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string", "pattern": "^/" },
            "mountPropagation": { "enum": ["None", "HostToContainer", "Bidirectional"] }
          }
        },
        "networkPolicy": {
          "type": "object",
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    }
  }
}
